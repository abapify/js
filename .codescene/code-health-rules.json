        { "name": "Large Method", "weight": 0.0 },
        { "name": "Code Duplication", "weight": 0.0 },
        { "name": "Lines of Code in a Single File", "weight": 0.0 },
        { "name": "Overall Code Complexity", "weight": 0.0 },
        { "name": "Complex Conditional", "weight": 0.0 },
        { "name": "Bumpy Road Ahead", "weight": 0.0 },
        { "name": "Deep, Nested Complexity", "weight": 0.0 },
        { "name": "Overall Function Size", "weight": 0.0 }
      ]
    },
    {
      "matching_content_path": "**/scripts/*.ts",
      "matching_content_path_doc": "Local build and generation scripts may contain longer procedural code; raise thresholds while still flagging egregious complexity.",
      "rules": [
        { "name": "Large Method", "weight": 0.0 },
        { "name": "Code Duplication", "weight": 0.0 }
      ],
      "thresholds": [
        { "name": "function_cyclomatic_complexity_warning", "value": 25 },
        { "name": "function_lines_of_code_warning", "value": 200 },
        { "name": "file_mean_cyclomatic_complexity_warning", "value": 10 }
