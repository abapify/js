    },
    {
      "matching_content_path": "**/mock-server/**",
      "matching_content_path_doc": "Mock server route wiring is generated fixture code; down-weight maintainability noise.",
      "rules": [
        { "name": "Complex Method", "weight": 0.0 },
        { "name": "Large Method", "weight": 0.0 },
        { "name": "Code Duplication", "weight": 0.0 },
        { "name": "Lines of Code in a Single File", "weight": 0.0 },
        { "name": "Overall Code Complexity", "weight": 0.0 },
        { "name": "Complex Conditional", "weight": 0.0 },
        { "name": "Bumpy Road Ahead", "weight": 0.0 },
        { "name": "Deep, Nested Complexity", "weight": 0.0 }
      ]
    }
  ]
}
