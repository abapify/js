# syntax=docker/dockerfile:1.7
FROM oven/bun:1.3.11 AS bun

FROM node:24-bookworm AS builder
ARG BUN_CONFIG_REGISTRY
ENV BUN_CONFIG_REGISTRY=${BUN_CONFIG_REGISTRY}
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
# The local Compose profile supplies the developer's trusted CA bundle as a
# BuildKit secret. It is added only to the builder's system trust store and
# never reaches the runtime image.
RUN --mount=type=secret,id=adt-server-build-ca,required=false \
    if [ -s /run/secrets/adt-server-build-ca ]; then \
      cp /run/secrets/adt-server-build-ca /usr/local/share/ca-certificates/adt-server-build-ca.crt \
        && update-ca-certificates; \
    fi
WORKDIR /build
COPY package.json bun.lock nx.json tsconfig.base.json tsconfig.json tsdown.config.ts ./
COPY packages/ ./packages/
COPY tools/ ./tools/
COPY samples/ ./samples/
COPY website/package.json ./website/package.json
RUN bun --use-system-ca install --frozen-lockfile --ignore-scripts
ENV NX_DAEMON=false NX_TUI=false
# The sidecar's emitted ESM keeps workspace packages external. Build its
# verified runtime closure in dependency order; `dist/` is excluded from the
# Docker context, so relying on source-tree artifacts would be unsafe.
RUN for package in \
      ts-xsd speci acds adt-config adt-lint adt-rfc \
      adt-schemas adt-contracts adt-client adt-locks adk adt-plugin adt-atc \
      adt-plugin-abapgit adt-plugin-gcts adt-tui adt-proxy \
      adt-plugin-gcts-cli adt-auth adt-aunit adt-cli adt-mcp adt-server; do \
      bun x tsdown --config "packages/$package/tsdown.config.ts"; \
    done

FROM node:24-bookworm-slim AS runtime
LABEL org.opencontainers.image.title="adt-server" org.opencontainers.image.description="Destination-aware ADT Server"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --create-home --home-dir /home/appuser appuser
COPY --from=builder --chown=root:root --chmod=755 /build/packages ./packages
COPY --from=builder --chown=root:root --chmod=755 /build/node_modules ./node_modules
COPY --from=builder --chown=root:root --chmod=644 /build/package.json ./package.json
COPY --chown=root:root --chmod=755 docker-entrypoint.adt-server.sh /usr/local/bin/docker-entrypoint.adt-server.sh
ENV HOME=/home/appuser NODE_ENV=production ADT_SERVER_HOST=0.0.0.0 ADT_SERVER_PORT=3002
EXPOSE 3002
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O- http://127.0.0.1:3002/readyz || exit 1
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.adt-server.sh"]
CMD ["node", "/app/packages/adt-server/dist/bin/adt-server.mjs"]
