{
  "name": "adt-plugin-gcts",
  "targets": {
    "codegen": {
      "command": "bun scripts/generate-aff-schemas.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{workspaceRoot}/git_modules/abap-file-formats/file-formats/{clas,intf,prog,doma,dtel,fugr,ddls,dcls,bdef,srvb,srvd,msag}/*-v1.json",
        "{projectRoot}/scripts/generate-aff-schemas.ts"
      ],
      "outputs": ["{projectRoot}/src/schemas/generated"]
    },
    "test": {
      "command": "node --import tsx --test tests/**/*.test.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": ["{projectRoot}/tests/**/*.ts", "{projectRoot}/src/**/*.ts"]
    }
  }
}
