{
  "name": "@abapify/adt-fixtures",
  "version": "0.4.1",
  "description": "SAP ADT XML fixtures for testing",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/src/fixtures/**/*",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/tsdown.config.ts",
          "{projectRoot}/package.json"
        ]
      }
    }
  }
}
