{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-tests",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": [
      "node",
      "vitest",
      "vitest/importMeta",
      "vite/client",
      "vitest/globals"
    ],
    "noPropertyAccessFromIndexSignature": true,
    "paths": {}
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "references": [
    { "path": "../adt-plugin/tsconfig.lib.json" },
    { "path": "../adt-config/tsconfig.lib.json" },
    { "path": "../adt-client" },
    { "path": "../adk/tsconfig.lib.json" }
  ]
}
