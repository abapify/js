{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-tests",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": [
      "node",
      "vitest",
      "vitest/importMeta",
      "vite/client",
      "vitest/globals"
    ],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
