<?xml version="1.0" encoding="UTF-8"?>
<!--
  abapGit TYPE (Type Group / Type Pool) Schema

  Defines the TYPE structure (TYPEGROUP, DESCRIPT) used in *.type.xml files.
  The actual type pool source lives alongside in <name>.type.abap.

  Uses xs:redefine to extend AbapValuesType with TYPE-specific elements.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.sap.com/abapxml"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">

  <!-- Include types (brought into asx namespace) -->
  <xs:include schemaLocation="types/typepool.xsd"/>

  <!-- Redefine AbapValuesType to include TYPE-specific elements -->
  <xs:redefine schemaLocation="asx.xsd">
    <xs:complexType name="AbapValuesType">
      <xs:complexContent>
        <xs:extension base="asx:AbapValuesType">
          <xs:sequence>
            <xs:element name="TYPE" type="asx:TypeGroupType" minOccurs="0"/>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:redefine>

  <!-- Import abapGit root element -->
  <xs:import schemaLocation="abapgit.xsd"/>

</xs:schema>
