<?xml version="1.0" encoding="UTF-8"?>
<!--
  abapGit TRAN (Transaction) Schema

  Defines TSTC (transaction code), TSTCC (GUI attributes) and
  TSTCT (texts) structures used in *.tran.xml files.

  Uses xs:redefine to extend AbapValuesType with TRAN-specific elements.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.sap.com/abapxml"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">

  <!-- Include types (brought into asx namespace) -->
  <xs:include schemaLocation="types/tstc.xsd"/>
  <xs:include schemaLocation="types/tstcc.xsd"/>
  <xs:include schemaLocation="types/tstct.xsd"/>

  <!-- Redefine AbapValuesType to include TRAN-specific elements -->
  <xs:redefine schemaLocation="asx.xsd">
    <xs:complexType name="AbapValuesType">
      <xs:complexContent>
        <xs:extension base="asx:AbapValuesType">
          <xs:sequence>
            <xs:element name="TSTC" type="asx:TstcType" minOccurs="0"/>
            <xs:element name="TSTCC" type="asx:TstccType" minOccurs="0"/>
            <xs:element name="TSTCT" type="asx:TstctTabType" minOccurs="0"/>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:redefine>

  <!-- Import abapGit root element -->
  <xs:import schemaLocation="abapgit.xsd"/>

</xs:schema>
