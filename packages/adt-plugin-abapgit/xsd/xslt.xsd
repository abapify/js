<?xml version="1.0" encoding="UTF-8"?>
<!--
  abapGit XSLT (Transformation) Schema

  Defines the XSLT structure (PROGNAME, DESCRIPT) used in *.xslt.xml files.
  The actual transformation source lives alongside in <name>.xslt.abap.

  Uses xs:redefine to extend AbapValuesType with XSLT-specific elements.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.sap.com/abapxml"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">

  <!-- Include types (brought into asx namespace) -->
  <xs:include schemaLocation="types/xslt.xsd"/>

  <!-- Redefine AbapValuesType to include XSLT-specific elements -->
  <xs:redefine schemaLocation="asx.xsd">
    <xs:complexType name="AbapValuesType">
      <xs:complexContent>
        <xs:extension base="asx:AbapValuesType">
          <xs:sequence>
            <xs:element name="XSLT" type="asx:XsltType" minOccurs="0"/>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:redefine>

  <!-- Import abapGit root element -->
  <xs:import schemaLocation="abapgit.xsd"/>

</xs:schema>
