<?xml version="1.0" encoding="UTF-8"?>
<!-- DD25V - View/Lock object header type (SAP DDIC structure DD25V) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="Dd25vType">
    <xs:all>
      <xs:element name="VIEWNAME" type="xs:string"/>
      <xs:element name="DDLANGUAGE" type="xs:string" minOccurs="0"/>
      <xs:element name="DDTEXT" type="xs:string" minOccurs="0"/>
      <xs:element name="VIEWCLASS" type="xs:string" minOccurs="0"/>
      <xs:element name="ROOTTAB" type="xs:string" minOccurs="0"/>
      <xs:element name="ROOTFIELD" type="xs:string" minOccurs="0"/>
      <xs:element name="ACTFLAG" type="xs:string" minOccurs="0"/>
      <xs:element name="MULTITAB" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

</xs:schema>
