<?xml version="1.0" encoding="UTF-8"?>
<!-- T100 - Message line type (SAP DDIC table T100) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="T100Type">
    <xs:sequence>
      <xs:element name="SPRSL" type="xs:string" minOccurs="0"/>
      <xs:element name="ARBGB" type="xs:string" minOccurs="0"/>
      <xs:element name="MSGNR" type="xs:string" minOccurs="0"/>
      <xs:element name="TEXT" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="T100TabType">
    <xs:sequence>
      <xs:element name="item" type="T100Type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
