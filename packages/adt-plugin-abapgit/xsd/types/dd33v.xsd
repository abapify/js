<?xml version="1.0" encoding="UTF-8"?>
<!-- DD33V - Search help field assignment type (SAP DDIC table DD33V) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="Dd33vType">
    <xs:sequence>
      <xs:element name="SHLPNAME" type="xs:string" minOccurs="0"/>
      <xs:element name="SHLPFIELD" type="xs:string" minOccurs="0"/>
      <xs:element name="TABNAME" type="xs:string" minOccurs="0"/>
      <xs:element name="FIELDNAME" type="xs:string" minOccurs="0"/>
      <xs:element name="SHLPINPUT" type="xs:string" minOccurs="0"/>
      <xs:element name="SHLPOUTPUT" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Dd33vTabType">
    <xs:sequence>
      <xs:element name="item" type="Dd33vType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
